import time
import fluidsynth

fs = fluidsynth.Synth()
fs.start(driver="pulseaudio")   # if this fails, try "alsa"
sfid = fs.sfload("/usr/share/sounds/sf2/FluidR3_GM.sf2")
fs.program_select(0, sfid, 0, 48)   # channel 0, bank 0, preset 0 = piano

fs.noteon(0, 60, 100)   # channel, note number, velocity
time.sleep(3)
fs.noteoff(0, 60)