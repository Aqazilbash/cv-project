import os
import time
import urllib.request

import cv2 as cv
import mediapipe as mp
from mediapipe.tasks import python as mp_python
from mediapipe.tasks.python import vision

# The Tasks API needs a separate model file. It is downloaded once, next to this script.
MODEL_URL = (
    "https://storage.googleapis.com/mediapipe-models/hand_landmarker/"
    "hand_landmarker/float16/1/hand_landmarker.task"
)
MODEL_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), "hand_landmarker.task")

# Pairs of landmark indices to connect with lines (21 landmarks per hand).
# The Tasks API doesn't ship drawing helpers, so we define the skeleton ourselves.
HAND_CONNECTIONS = [
    (0, 1), (1, 2), (2, 3), (3, 4),          # thumb
    (0, 5), (5, 6), (6, 7), (7, 8),          # index finger
    (5, 9), (9, 10), (10, 11), (11, 12),     # middle finger
    (9, 13), (13, 14), (14, 15), (15, 16),   # ring finger
    (13, 17), (17, 18), (18, 19), (19, 20),  # pinky
    (0, 17),                                  # palm edge
]


def ensure_model():
    if not os.path.exists(MODEL_PATH):
        print("Downloading hand landmarker model (one time)...")
        urllib.request.urlretrieve(MODEL_URL, MODEL_PATH)
        print("Saved to", MODEL_PATH)


def draw_hand(frame, landmarks, label):
    """Draw one hand's landmarks onto the frame (BGR image)."""
    h, w = frame.shape[:2]

    # Landmarks are normalized (0.0 to 1.0), so scale them to pixel coordinates.
    points = [(int(lm.x * w), int(lm.y * h)) for lm in landmarks]

    for start, end in HAND_CONNECTIONS:
        cv.line(frame, points[start], points[end], (255, 255, 255), 2)
    for x, y in points:
        cv.circle(frame, (x, y), 4, (0, 200, 0), -1)

    # Label the hand near the wrist (landmark 0).
    cv.putText(frame, label, (points[0][0], points[0][1] + 25),
               cv.FONT_HERSHEY_SIMPLEX, 0.8, (0, 200, 255), 2)


def main():
    ensure_model()

    options = vision.HandLandmarkerOptions(
        base_options=mp_python.BaseOptions(model_asset_path=MODEL_PATH),
        running_mode=vision.RunningMode.VIDEO,  # video frames, processed one at a time
        num_hands=2,
        min_hand_detection_confidence=0.5,
        min_hand_presence_confidence=0.5,
        min_tracking_confidence=0.5,
    )

    cam = cv.VideoCapture(0)
    if not cam.isOpened():
        print("Could not open camera")
        return

    start_time = time.monotonic()

    with vision.HandLandmarker.create_from_options(options) as landmarker:
        while cam.isOpened():
            success, frame = cam.read()
            if not success:
                print("Camera frame not available")
                break

            # Mirror the image so it behaves like a mirror (also keeps Left/Right labels correct).
            frame = cv.flip(frame, 1)

            # OpenCV gives BGR; MediaPipe wants RGB wrapped in an mp.Image.
            rgb = cv.cvtColor(frame, cv.COLOR_BGR2RGB)
            mp_image = mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb)

            # VIDEO mode requires a timestamp in milliseconds that always increases.
            timestamp_ms = int((time.monotonic() - start_time) * 1000)
            result = landmarker.detect_for_video(mp_image, timestamp_ms)

            # result.hand_landmarks: list of hands, each a list of 21 landmarks
            # result.handedness: list of hands, each a list of categories (Left/Right)
            for landmarks, handedness in zip(result.hand_landmarks, result.handedness):
                draw_hand(frame, landmarks, handedness[0].category_name)

            cv.imshow("Show Video", frame)

            if cv.waitKey(1) & 0xFF == ord("q"):
                break

    cam.release()
    cv.destroyAllWindows()


if __name__ == "__main__":
    main()